.DS_Store
node_modules/
dist/
.venv
__pycache__/
# Swiss Ephemeris data files must not be redistributed (Astrodienst terms)
*.se1
tools/cache/

# Reaction exports carry personal data (a named reader's comments) — never
# commit them, and never let them sit in data/ (served publicly). The vite
# build also blocks any *reactions* file under data/. See PITFALLS.
*reactions*.json

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
